{
  "$schema": "https://kudobydeck.com/schemas/plugin-manifest.v1.json",
  "id": "com.kudobydeck.sample-plugin",
  "name": "Quick Action Controller",
  "version": "1.0.0",
  "author": "Kudoby Technologies Pvt. Ltd.",
  "website": "https://kudobydeck.com",
  "description": "Demonstrates Kudoby Deck plugin architecture with Property Inspector settings, SVG LCD updates, and rotary dial controls.",
  "minKudobyVersion": "2.6.0",
  "category": "Broadcast Automation",
  "entryPoint": "dist/index.js",
  "actions": [
    {
      "uuid": "toggle-mic",
      "name": "Mute / Unmute Mic",
      "tooltip": "Toggles microphone audio input with real-time tally state and SVG icon",
      "defaultIcon": "assets/mic.svg",
      "supportedStates": ["live", "off"],
      "hasSettings": true,
      "settings": [
        {
          "key": "channelName",
          "label": "Audio Channel",
          "type": "select",
          "default": "mic",
          "options": ["mic", "discord", "spotify", "master"]
        },
        {
          "key": "liveLabel",
          "label": "Live Label",
          "type": "text",
          "default": "MIC LIVE",
          "placeholder": "Label when unmuted"
        },
        {
          "key": "hapticFeedback",
          "label": "Haptic Pulse on Press",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "uuid": "master-volume-dial",
      "name": "Master Volume Knob",
      "tooltip": "Virtual rotary dial for volume level adjustments",
      "type": "rotary-dial",
      "step": 2,
      "min": 0,
      "max": 100
    }
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kudobydeck.com/schemas/plugin-manifest.v1.json",
  "title": "Kudoby Deck Plugin Manifest v1",
  "description": "Manifest schema for Kudoby Stream Deck Studio plugins (@kudobydeck/deck-sdk)",
  "type": "object",
  "required": ["id", "name", "version", "entryPoint", "actions"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "Reverse-domain unique plugin identifier (e.g. com.creator.obs-fx)"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
    },
    "author": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "minKudobyVersion": {
      "type": "string",
      "default": "2.6.0"
    },
    "category": {
      "type": "string"
    },
    "entryPoint": {
      "type": "string",
      "description": "Relative path to compiled JS entrypoint (e.g. dist/index.js)"
    },
    "icon": {
      "type": "string",
      "description": "Relative path to plugin icon (SVG or PNG)"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uuid", "name"],
        "properties": {
          "uuid": { "type": "string" },
          "name": { "type": "string" },
          "tooltip": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["button", "rotary-dial", "toggle", "hud"],
            "default": "button"
          },
          "defaultIcon": { "type": "string" },
          "defaultColor": { "type": "string" },
          "supportedStates": {
            "type": "array",
            "items": { "type": "string" }
          },
          "hasSettings": { "type": "boolean" },
          "step": { "type": "number" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "settings": {
            "type": "array",
            "description": "Property Inspector schema rendered inside Kudoby Desktop Studio",
            "items": {
              "type": "object",
              "required": ["key", "label", "type"],
              "properties": {
                "key": { "type": "string" },
                "label": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["text", "password", "number", "boolean", "select", "color"]
                },
                "default": {},
                "placeholder": { "type": "string" },
                "options": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "object",
                        "required": ["label", "value"],
                        "properties": {
                          "label": { "type": "string" },
                          "value": { "type": "string" }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
